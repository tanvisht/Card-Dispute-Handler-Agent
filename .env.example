# --- LLM ---
ANTHROPIC_API_KEY=
TRIAGE_MODEL=claude-sonnet-5-5
TRIAGE_CLASSIFIER=llm            # llm | rules  (rules = offline keyword baseline, no API key needed)
TRIAGE_CONFIDENCE_THRESHOLD=0.75 # below this -> needs_human_review
TRIAGE_PROMPT_VERSION=v1

# --- Storage ---
TRIAGE_STORAGE=sqlite            # sqlite | snowflake
TRIAGE_SQLITE_PATH=data/triage.db

SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=TRIAGE_ROLE
SNOWFLAKE_WAREHOUSE=TRIAGE_WH
SNOWFLAKE_DATABASE=DISPUTE_TRIAGE
SNOWFLAKE_SCHEMA=CORE
